DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# Example with EC2 IP 13.250.10.20:
# NUXT_PUBLIC_SITE_URL=http://healthwellness.13.250.10.20.nip.io
# NUXT_PUBLIC_STRAPI_URL=http://cms.healthwellness.13.250.10.20.nip.io
# NGINX_FRONTEND_HOST=healthwellness.13.250.10.20.nip.io
# NGINX_CMS_HOST=cms.healthwellness.13.250.10.20.nip.io
NUXT_PUBLIC_SITE_URL=http://healthwellness.YOUR_EC2_PUBLIC_IP.nip.io
NUXT_PUBLIC_STRAPI_URL=http://cms.healthwellness.YOUR_EC2_PUBLIC_IP.nip.io
NGINX_FRONTEND_HOST=healthwellness.YOUR_EC2_PUBLIC_IP.nip.io
NGINX_CMS_HOST=cms.healthwellness.YOUR_EC2_PUBLIC_IP.nip.io
PUBLIC_URL=http://cms.healthwellness.YOUR_EC2_PUBLIC_IP.nip.io
STRAPI_PROXY=true

# Optional. Leave empty if Public role allows read access.
NUXT_STRAPI_API_TOKEN=

# Strapi production secrets. Generate strong random values before deploy.
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&channel_binding=require
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Keep false in production unless you intentionally want seed data.
STRAPI_SEED=false
