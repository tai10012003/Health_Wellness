HOST=0.0.0.0
PORT=1337
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me

DATABASE_CLIENT=postgres

# Neon/PostgreSQL cloud connection. Use this in deployed or cloud database mode.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Local Docker PostgreSQL fallback. Used when DATABASE_URL is not set.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=health_wellness
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Optional S3 uploads. Leave AWS_BUCKET empty to keep local upload provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=
AWS_S3_ROOT_PATH=uploads
AWS_S3_BASE_URL=
AWS_ACL=

STRAPI_SEED=false
